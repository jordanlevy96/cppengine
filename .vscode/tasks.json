{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Imhotep (Debug)",
      "type": "shell",
      "command": "make -j8",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "dependsOn": ["CMake Configure (Debug)"]
    },
    {
      "label": "Build Imhotep (Release)",
      "type": "shell",
      "command": "make -j8",
      "options": {
        "cwd": "${workspaceFolder}/build-release"
      },
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "dependsOn": ["CMake Configure (Release)"]
    },
    {
      "label": "CMake Configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_BUILD_TYPE=Debug",
        ".."
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "CMake Configure (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_BUILD_TYPE=Release",
        ".."
      ],
      "options": {
        "cwd": "${workspaceFolder}/build-release"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Clean Build Directory",
      "type": "shell",
      "command": "rm -rf build && mkdir build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Full Rebuild (Debug)",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Clean Build Directory",
        "Build Imhotep (Debug)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Imhotep",
      "type": "shell",
      "command": "./imhotep",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Run Imhotep Editor",
      "type": "shell",
      "command": "./imhotep-editor",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
